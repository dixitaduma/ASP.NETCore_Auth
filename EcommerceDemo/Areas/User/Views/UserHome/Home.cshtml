<style>
    * {
        padding: 0;
        margin: 0;
    }

    body {
        background: #07212e;
        background-size: cover;
        background-position: center;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    h3 {
        color: #fff;
    }


    .main-container {
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 4.25rem !important;
    }

    /* form { */
    /*     background-color: #fff; */
    /* } */

    .form-control:focus,
    .form-select:focus {
        border-color: #ff9800;
        box-shadow: 0 0 5px rgba(255, 152, 0, 0.8);
    }

    label {
        color: #ff9800;
        font-weight: 600;
    }

    .btn-success {
        background-color: #ff9800;
        border-color: #ff9800;
    }

        .btn-success:hover {
            background-color: #e68a00;
            border-color: #e68a00;
        }

    .btn-outline-secondary {
        color: #ff9800;
        border-color: #ff9800;
    }

        .btn-outline-secondary:hover {
            background-color: #ff9800;
            color: #fff;
        }

    .alert-danger {
        background-color: rgba(255, 0, 0, 0.1);
        color: red;
        border: 1px solid red;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #ff9800;
    }

    .form-floating {
        position: relative;
    }

    .heding {
        color: #ff9800;
    }

    .right-image {
        object-fit: cover;
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
    }
</style>

<div class=" main-container shadow rounded container mt-2 mb-5  border">
    <div class=" row align-items-stretch">

        <div class="col-lg-6 d-flex col-md-12   ">
            <div asp-area="User" asp-controller="UserAuth" asp-action="Login" 
                  class=" m-5 p-4 w-90 d-flex flex-column justify-content-between  ">

                <h3 class="heding text-center fw-bold mb-4">Black friday Sale </h3>
                <p></p>

                <h1> New Collection 2025</h1>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="button" class="btn btn-success px-4 py-2 fw-semibold shadow-sm w-100  mt-3">
                        Shop now
                    </button>
                   
                </div>

               

                <div class="text-center mt-3">
                    <span> Not have an account?</span>
                    <a asp-action="UserRegistration" class="text-decoration-none fw-semibold" style="color: #ff9800;">
                        Register here
                    </a>
                </div>

            </div>
        </div>

        <!-- Right: Image -->
        <div class="col-lg-6 d-none d-lg-block p-5">
            <img src="@Url.Content("~/Images/login-right-side-image.jpg")" alt="Registration Image" class="right-image">
        </div>
    </div>
</div>




<div id="carouselExampleCaptions" class="carousel slide my-3" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="@Url.Content("~/Images/benner-slide-1.jpg")" class="d-block w-100" style="height:500px" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>First slide label</h5>
                <p>Nulla vitae elit libero, a pharetra augue mollis interdum.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="@Url.Content("~/Images/benner-slide-2.jpg")" class="d-block w-100" style="height:500px" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>Second slide label</h5>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="@Url.Content("~/Images/benner-slide-3.jpg")" class="d-block w-100" style="height:500px" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>Third slide label</h5>
                <p>Praesent commodo cursus magna, vel scelerisque nisl consectetur.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>






@section Scripts {
    <partial name="_ValidationScriptsPartial" />
  
}

