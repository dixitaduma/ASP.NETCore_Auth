@model EcommerceDemo.Areas.User.Models.VMForgetPassword

@{
    ViewData["Title"] = "User Registration";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    * {
        padding: 0;
        margin: 0;
    }

    body {
        background: #07212e;
        background-size: cover;
        background-position: center;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    h3 {
        color: #fff;
    }


    .main-container {
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 4.25rem !important;
    }

    form {
        background-color: rgba(255, 255, 255, 0.95);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ff9800;
        box-shadow: 0 0 5px rgba(255, 152, 0, 0.8);
    }

    label {
        color: #ff9800;
        font-weight: 600;
    }

    .btn-success {
        background-color: #ff9800;
        border-color: #ff9800;
    }

        .btn-success:hover {
            background-color: #e68a00;
            border-color: #e68a00;
        }

    .btn-outline-secondary {
        color: #ff9800;
        border-color: #ff9800;
    }

        .btn-outline-secondary:hover {
            background-color: #ff9800;
            color: #fff;
        }

    .alert-danger {
        background-color: rgba(255, 0, 0, 0.1);
        color: red;
        border: 1px solid red;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #ff9800;
    }

    .form-floating {
        position: relative;
    }

    .heding {
        color: #ff9800;
    }

    .right-image {
        object-fit: cover;
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
    }
</style>

<div class=" main-container shadow rounded container mt-5 mb-5  border">
    <div class="   row  align-items-stretch">

        <div class="col-lg-6 d-flex align-items-center   ">
            <form asp-area="User" asp-controller="UserAuth" asp-action="ForgetPassword" enctype="multipart/form-data" method="post"
                  class="border m-5 p-4 shadow rounded w-50">

                <h3 class="heding text-center fw-bold mb-4"> Forget Password </h3>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>



                <input class="hiddenfield" asp-for="IsOtpVerified" hidden />

                <div class="form-floating mt-3">
                    <input asp-for="UserEmail" class="form-control" placeholder="Email" disabled />
                    <input asp-for="UserEmail" class="form-control" placeholder="Email" hidden />
                    @* <p> @Model.UserEmail</p> *@
                    <label asp-for="UserEmail"></label>
                    <span asp-validation-for="UserEmail" class="text-danger small"></span>
                </div>

                <div class="form-floating mt-3">
                    <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Password" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <span class="password-toggle" onclick="togglePassword('password', this)">👁️</span>
                </div>

                <div class="form-floating mt-3">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" placeholder="Confirm Password" />
                    <label asp-for="ConfirmPassword"></label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    <span class="password-toggle" onclick="togglePassword('confirmPassword', this)">👁️</span>
                </div>






                @* Forgate Password *@


                <div class="d-flex justify-content-between align-items-center mt-4">


                    <button type="submit" class="btn btn-success px-4 py-2 fw-semibold shadow-sm w-100  mt-3">
                        Submit
                    </button>

                </div>




            </form>

        </div>

        <!-- Right: Image -->
        <div class="col-lg-6 d-none d-lg-block p-5">
            <img src="@Url.Content("~/Images/Otp-Verification-Page.jpg")" alt="Registration Image" class="right-image">
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, toggleIcon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                toggleIcon.textContent = "🙈";
            } else {
                input.type = "password";
                toggleIcon.textContent = "👁️";
            }
        }
    </script>

}
