@model EcommerceDemo.Areas.User.Models.VMGenerateOtp

@{
    ViewData["Title"] = "User Registration";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    * {
        padding: 0;
        margin: 0;
    }

    body {
        background: #07212e;
        background-size: cover;
        background-position: center;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    h3 {
        color: #fff;
    }


    .main-container {
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 4.25rem !important;
    }

    form {
        background-color: rgba(255, 255, 255, 0.95);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ff9800;
        box-shadow: 0 0 5px rgba(255, 152, 0, 0.8);
    }

    label {
        color: #ff9800;
        font-weight: 600;
    }

    .btn-success {
        background-color: #ff9800;
        border-color: #ff9800;
    }

        .btn-success:hover {
            background-color: #e68a00;
            border-color: #e68a00;
        }

    .btn-outline-secondary {
        color: #ff9800;
        border-color: #ff9800;
    }

        .btn-outline-secondary:hover {
            background-color: #ff9800;
            color: #fff;
        }

    .alert-danger {
        background-color: rgba(255, 0, 0, 0.1);
        color: red;
        border: 1px solid red;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #ff9800;
    }

    .form-floating {
        position: relative;
    }

    .heding {
        color: #ff9800;
    }

    .right-image {
        object-fit: cover;
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
    }
</style>

<div class=" main-container shadow rounded container mt-5 mb-5  border">
    <div class="   row  align-items-stretch">

        <div class="col-lg-6 d-flex align-items-center   ">
            <form asp-area="User" asp-controller="UserAuth" asp-action="GenerateOtp" enctype="multipart/form-data" method="post"
                  class="border m-5 p-4 shadow rounded w-100">

                <h3 class="heding text-center fw-bold  mb-4">Otp Verification </h3>
                <h6 class=" text-center mb-2">Enter your email address</h6>
                <p class=" text-center ">You will receive an email with one-time password </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <!-- Column 1 -->
                    <div class="col-md-12">


                        <div class="form-floating mt-3">
                            <input asp-for="UserEmail" class="form-control" placeholder="Email" />
                            <label asp-for="UserEmail"></label>
                            <span asp-validation-for="UserEmail" class="text-danger small"></span>
                        </div>




                    </div>
                </div>


                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn btn-success px-4 py-2 fw-semibold shadow-sm w-100">
                        Generate Otp
                    </button>

                </div>

            </form>

        </div>

        <!-- Right: Image -->
        <div class="col-lg-6 d-none d-lg-block p-5">
            <img src="@Url.Content("~/Images/Otp-Verification-Page.jpg")" alt="Otp verification Image" class="right-image">
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
